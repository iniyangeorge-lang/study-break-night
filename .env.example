# Copy this file to .env and fill in the values.
# Supabase dashboard -> Project Settings -> API (or "Connect").
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key ONLY. Never put the service_role / secret key here:
# everything prefixed VITE_ is bundled into the public website.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public Telegram channel where organisers announce extra cups.
VITE_TELEGRAM_CHANNEL_URL=https://t.me/your_channel
